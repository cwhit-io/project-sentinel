# Reference metadata only. Do not copy this file to .env. Standard Docker Compose
# does not dereference secret:// references. Use a protected shell/loader to inject
# runtime values and require --env-file /dev/null; never store resolved values here.
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=secret://sentinel/postgres/password
POSTGRES_DB=zabbix
ZBX_SERVER_HOST=zabbix-server
ZBX_SERVER_NAME=Sentinel Zabbix
# Keep host exposure loopback-only unless a reviewed firewall or TLS proxy is used.
ZBX_WEB_PORT=8080
ZBX_SERVER_PORT=10051
OPENBAO_PORT=18200
TZ=UTC
